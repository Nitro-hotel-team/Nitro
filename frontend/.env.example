# ============================================================================
# NITRO GRAND HOTEL 4★ — CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (FRONTEND CLIENT)
# Đồ án môn học: Quản lý Dự án Công nghệ Thông tin — Nhóm 7
# Tài liệu bàn giao triển khai kỹ thuật (Sprint 4 — TASK-66 / FE-S4-10)
# ============================================================================

# 1. KẾT NỐI MÁY CHỦ BACKEND REST API
# - Môi trường phát triển cục bộ: http://localhost:5000
# - Môi trường staging/production: https://api.nitrohotel.vn
# - LƯU Ý: Nếu backend offline hoặc gặp sự cố mạng, cơ chế Dual-Mode API sẽ tự động
#   chuyển tiếp sang dữ liệu mô phỏng In-Memory Mock Data mà không làm gián đoạn trải nghiệm.
VITE_API_URL=http://localhost:5000

# 2. CƠ CHẾ DUAL-MODE DỮ LIỆU
# - true: Cưỡng bức sử dụng mock data 4 sao nội bộ (phục vụ thuyết trình/chấm điểm offline)
# - false: Ưu tiên gọi REST API thực tế, tự động fallback nếu backend ngoại tuyến
VITE_USE_MOCK=false

# 3. XÁC THỰC GOOGLE OAUTH 2.0
# - Client ID đăng ký từ Google Cloud Console phục vụ chức năng đăng nhập 1 chạm
VITE_GOOGLE_CLIENT_ID="109823478912-nitrohotelclientid.apps.googleusercontent.com"

# 4. MÔI TRƯỜNG HOẠT ĐỘNG
# - development: Bật đầy đủ công cụ hỗ trợ gỡ lỗi và switcher vai trò demo
# - production: Kích hoạt bộ lọc bảo mật lọc dữ liệu nhạy cảm console log
VITE_APP_ENV=production

# 5. THÔNG TIN THƯƠNG HIỆU & KHÁCH SẠN 4 SAO
VITE_HOTEL_NAME="Nitro Grand Hotel"
VITE_HOTEL_HOTLINE="1900 6868"
VITE_HOTEL_ADDRESS="24 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh"
VITE_HOTEL_EMAIL="contact@nitrohotel.vn"
VITE_HOTEL_WEBSITE="https://nitrohotel.vn"
